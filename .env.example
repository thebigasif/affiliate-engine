# Attribution signing secret (>= 32 bytes; hex/base64 values are measured
# after decoding). Generate one with:
#     openssl rand -hex 32
# Placeholder values (anything containing "change-me") are refused. Leave it
# unset to have the engine generate one and persist it next to the SQLite db
# (<db>.secret, mode 0600) or at AE_SECRET_FILE.
# The click identity hashes (ip_hash/ua_hash) are keyed from this secret:
# changing it restarts unique counts and IP-based fraud windows.
# AE_TOKEN_SECRET=
# AE_SECRET_FILE=/data/affiliate-engine.secret   # generated-secret location override

# Redirect destination allowlist, semicolon-separated host suffixes.
# Subdomains of a suffix are allowed (shop.example.com matches example.com).
AE_ALLOWED_DEST=example.com

# Stripe webhook signing secret (whsec_...). Unset = webhook route disabled.
# AE_STRIPE_SECRET=whsec_live_...

# --- Billing webhook signing secrets (unset = route disabled) ---
# AE_STRIPE_SECRET serves webhooks AND payouts (same restricted key);
# AE_STRIPE_SECRET_KEY is honored as an alias.
# AE_STRIPE_SECRET=whsec_...
# AE_PADDLE_SECRET=
# AE_CHARGEBEE_USERNAME=                 # Basic Auth (Chargebee's native webhook protection; either enables it)
# AE_CHARGEBEE_PASSWORD=
# AE_CHARGEBEE_SECRET=                   # legacy cb-signature HMAC; with Basic Auth, also checks cb-signature when sent
# AE_LEMONSQUEEZY_SECRET=
# AE_RECURLY_USERNAME=                   # Basic Auth user (either one enables /webhooks/recurly)
# AE_RECURLY_PASSWORD=
# AE_RECURLY_SIGNATURE_SECRET=           # only for JSON-mode endpoints (XML endpoints are unsigned)

# --- Payouts ---
# AE_STRIPE_SECRET_KEY=sk_live_...        # Stripe Connect payout execution

# --- Portal / cookies ---
# AE_PUBLIC_URL=https://aff.example.com   # external origin; https => Secure cookies
# AE_COOKIE_SECURE=1                      # force Secure cookies behind TLS
# AE_HSTS=0                               # stop sending Strict-Transport-Security on HTTPS requests

# --- Reverse proxy / abuse limits ---
# Only peers in these CIDRs may set X-Forwarded-For / X-Forwarded-Proto /
# CDN geo headers. Unset = trust nobody (RemoteAddr is the client).
# AE_TRUSTED_PROXIES=10.0.0.0/8,173.245.48.0/20
# AE_REDIRECT_RATE_PER_MIN=120            # /r/ hits per client IP per minute (-1 disables)

# --- Postgres two-role setup (see DEPLOY.md) ---
# AE_MIGRATE_DATABASE_URL=postgres://ae_owner:...@db:5432/affiliate?sslmode=verify-full

# --- Fraud screening shadow mode ---
# AE_FRAUD_DRYRUN=1                       # screen without enforcing (also the 5-min sweep)

# --- Test-only (dual-engine suite) ---
# AE_TEST_ENGINES=postgres
# AE_TEST_PG_ADMIN_DSN=postgres://user@host:5432/postgres?sslmode=disable
